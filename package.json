{
  "name": "barve-guruji-ai",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "A local-first, frontend-only PWA for verified Panchang context and traditional guidance.",
  "scripts": {
    "dev": "vite",
    "icons": "node scripts/generate-icons.mjs",
    "build": "npm run icons && vite build && node scripts/generate-sw.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "astronomy-engine": "^2.1.19",
    "dompurify": "^3.2.7",
    "idb": "^8.0.3",
    "marked": "^16.4.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.55.0",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^24.3.1",
    "eslint": "^9.35.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "sharp": "^0.34.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.4",
    "vitest": "^3.2.4"
  }
}
